<Window x:Class="Amsur.Wpf.GenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Amsur.Wpf"
        Title="Составление расписания" Height="780" Width="1100"
        MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource ChromeWindow}"
        Background="{DynamicResource BBg}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24" MaxWidth="1200">
    <!-- Верх: заголовок + честный статус (без ложного процента) -->
    <Border Style="{DynamicResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" Style="{DynamicResource TH1}" FontSize="20" VerticalAlignment="Center"/>
          <Border Style="{DynamicResource Badge}" Background="{DynamicResource BAccentSoft}"
                  Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="поиск решения" FontSize="11" Foreground="{DynamicResource BAccent}"/>
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding QualityProfileText}" FontSize="13" Foreground="{DynamicResource BTextSoft}" Margin="0,4,0,0"/>
        <!-- Режимы: справка по лимитам (выбор — на главной до запуска), честная производная BudgetSeconds -->
        <TextBlock Text="Режимы (выбор — на главной до запуска):" Style="{DynamicResource THCaption}" Margin="0,12,0,6"/>
        <UniformGrid x:Name="ModeStrip" Columns="4" Rows="1"/>
      </StackPanel>
    </Border>

    <!-- Стадии VM: 4 шага, текущая выделяется (логика имён — из VM, не переименовываем) -->
    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,12,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="StageFrame" CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                  Background="{DynamicResource BCard}" BorderBrush="{DynamicResource BBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="StageDot" CornerRadius="10" Width="20" Height="20"
                      Background="{DynamicResource BSubtle}" VerticalAlignment="Center">
                <TextBlock x:Name="StageMark" Text="·" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource BTextMuted}"/>
              </Border>
              <TextBlock x:Name="StageText" Text="{Binding Name}" FontSize="13" Margin="8,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource BTextSoft}"/>
            </StackPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="StageFrame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              <Setter TargetName="StageFrame" Property="BorderThickness" Value="2"/>
              <Setter TargetName="StageFrame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              <Setter TargetName="StageText" Property="FontWeight" Value="Bold"/>
              <Setter TargetName="StageText" Property="Foreground" Value="{DynamicResource BAccent}"/>
              <Setter TargetName="StageDot" Property="Background" Value="{DynamicResource BAccent}"/>
              <Setter TargetName="StageMark" Property="Text" Value="→"/>
              <Setter TargetName="StageMark" Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
              <Setter TargetName="StageDot" Property="Background" Value="{DynamicResource BGood}"/>
              <Setter TargetName="StageMark" Property="Text" Value="✓"/>
              <Setter TargetName="StageMark" Property="Foreground" Value="White"/>
              <Setter TargetName="StageText" Property="Foreground" Value="{DynamicResource BText}"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" Rows="1"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- Метрики: только то, что отдаёт VM (без итераций/ID/памяти) -->
    <UniformGrid Columns="4" Rows="1" Margin="0,12,0,0">
      <Border Style="{DynamicResource Card}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="ПЕРВОЕ РЕШЕНИЕ" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding FirstFeasibleText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="3,0,3,0">
        <StackPanel>
          <TextBlock Text="ЛУЧШЕЕ СЕЙЧАС" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding BestText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                     Foreground="{DynamicResource BAccent}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="3,0,3,0">
        <StackPanel>
          <TextBlock Text="ВАРИАНТОВ В ПУЛЕ" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding CandidatesText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="6,0,0,0">
        <StackPanel>
          <TextBlock Text="ВРЕМЯ РАСЧЁТА" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding ElapsedText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Прогресс (честный: неопределённый, пока идёт) + Остановить -->
    <Border Style="{DynamicResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <ProgressBar x:Name="RunProgress" Height="8" Minimum="0" Maximum="1"
                     IsIndeterminate="{Binding CanStop}" Foreground="{DynamicResource BAccent}"
                     Background="{DynamicResource BSubtle}" BorderThickness="0"/>
        <DockPanel Margin="0,10,0,0">
          <TextBlock Style="{DynamicResource THint}" FontSize="12" VerticalAlignment="Center"
                     Text="Лучшее найденное решение сохраняется автоматически — остановку можно нажать в любой момент."/>
          <Button x:Name="StopButton" Content="⦸  Остановить расчёт" Style="{DynamicResource BtnSecondary}"
                  DockPanel.Dock="Right" Margin="12,0,0,0" Padding="16,8"
                  Foreground="{DynamicResource BBad}" IsEnabled="{Binding CanStop}" Click="OnStopClick"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Ход улучшения — только полученные события -->
    <TextBlock Text="Ход улучшения" Style="{DynamicResource TH2}" Margin="0,20,0,8"/>
    <Border Style="{DynamicResource Card}">
      <local:TrajectoryChart x:Name="Chart"/>
    </Border>

    <!-- Top-5: только реальные карточки, без пустых -->
    <DockPanel Margin="0,20,0,8">
      <TextBlock Text="{Binding Top5.HeaderText}" Style="{DynamicResource TH2}" VerticalAlignment="Center"/>
      <TextBlock Style="{DynamicResource THCaption}" DockPanel.Dock="Right" VerticalAlignment="Center"
                 Text="сортировка — по качеству (Soft)"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding Top5.Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Border Style="{DynamicResource Badge}" Background="{DynamicResource BAccentSoft}"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource BAccent}"/>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SoftText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding HardText}" FontSize="12" Foreground="{DynamicResource BTextSoft}"
                             Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding QualitySummary}" FontSize="13" FontStyle="Italic" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="Почему такая оценка:" FontSize="12" Foreground="{DynamicResource BTextSoft}" Margin="0,6,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding QualityLines.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding QualityLines}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource BTextSoft}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding DifferenceLines}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Открыть в редакторе" Style="{DynamicResource BtnSecondary}" Tag="{Binding}"
                        Click="OnOpenClick"/>
                <Button Content="✓  Принять этот вариант" FontSize="13"
                        Padding="12,7" Margin="8,0,0,0" Tag="{Binding}" Click="OnAcceptClick">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{DynamicResource BtnPrimary}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CanAccept}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Итог приёмки + активная версия -->
    <TextBlock Text="{Binding AcceptResultText}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding ActiveVersionText}" FontSize="13" Foreground="{DynamicResource BTextSoft}"/>

    <!-- Diagnostics: свернута по умолчанию, имена сохранены -->
    <Border Style="{DynamicResource Card}" Margin="0,12,0,0">
      <Expander Header="Подробности генерации" IsExpanded="{Binding DiagnosticsExpanded}" FontSize="13">
        <StackPanel Margin="8,8,0,0">
          <TextBlock x:Name="DiagSeed" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagWorkers" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagPhase" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagSolver" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagElapsed" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagObjective" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagValidation" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagCounts" FontSize="12" Style="{DynamicResource THCaption}"/>
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
  </ScrollViewer>
</Window>
