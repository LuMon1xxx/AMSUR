<UserControl x:Class="Amsur.Wpf.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- P-D0: временная заглушка переезжающего раздела. Удаляется пакетом,
       который привозит настоящий view (см. план §5). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" MaxWidth="760" TextElement.Foreground="{DynamicResource BText}">
      <TextBlock x:Name="TitleText" Style="{StaticResource TH1}" Text="Раздел"/>
      <TextBlock x:Name="SubText" Style="{StaticResource THint}" Margin="0,4,0,0" Text=""/>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="{StaticResource BWarm}"
              BorderBrush="{StaticResource BWarmBorder}">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TipText" Style="{StaticResource THint}" FontSize="13"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Раздел в разработке. Пока всё доступно старым окном."/>
        </StackPanel>
      </Border>
      <Button x:Name="LegacyBtn" Content="Открыть старым окном (временно)" Style="{StaticResource BtnSecondary}"
              Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnLegacyClick"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
