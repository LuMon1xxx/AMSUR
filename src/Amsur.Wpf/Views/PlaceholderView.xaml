<UserControl x:Class="Amsur.Wpf.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- P-D0: временная заглушка переезжающего раздела. Удаляется пакетом,
       который привозит настоящий view (см. план §5). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" MaxWidth="760" TextElement.Foreground="{DynamicResource BText}">
      <TextBlock x:Name="TitleText" Style="{StaticResource TH1}" Text="Раздел"/>
      <TextBlock x:Name="SubText" Style="{StaticResource THint}" Margin="0,4,0,0" Text=""/>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="{StaticResource BWarm}"
              BorderBrush="{StaticResource BWarmBorder}">
        <StackPanel Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource BAccent}"
                  VerticalAlignment="Center">
            <TextBlock Text="Г" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="Гуфо — помощник АМСУР"/>
          </Border>
          <TextBlock x:Name="TipText" Style="{StaticResource THint}" FontSize="13" Margin="12,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Гуфо уже обустраивает этот раздел. Пока он работает — всё доступно старым окном."/>
        </StackPanel>
      </Border>
      <Button x:Name="LegacyBtn" Content="Открыть старым окном (временно)" Style="{StaticResource BtnSecondary}"
              Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnLegacyClick"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
