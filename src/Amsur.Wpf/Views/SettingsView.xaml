<UserControl x:Class="Amsur.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BBg}">
  <!-- P-D3: настройки как view (контент из SettingsWindow 1-в-1).
       «Отмена» = выйти без применения (view пересоздаётся при каждом входе). -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TH1}" FontSize="20" Text="Настройки качества"/>
          <TextBlock Style="{StaticResource THint}" Margin="0,4,0,0"
                     Text="Обычному завучу ничего настраивать не нужно. Изменения вступают в силу после кнопки «Применить» и действуют на следующие генерации."/>
        </StackPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource BGoodBg}"
                VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="SavedNameText" FontSize="12" Foreground="{StaticResource BGood}" Text=""/>
        </Border>
      </DockPanel>
      <!-- Пресеты: 4 карточки (имена сохранены, описания честные — без выдуманных секунд/сложности) -->
      <UniformGrid Columns="4" Rows="1" Margin="0,12,0,0">
        <RadioButton x:Name="PresetStandard" GroupName="Preset" Style="{StaticResource RadioCard}"
                     Margin="0,0,6,0" Checked="OnPresetChanged">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Стандарт" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Badge}" Background="{StaticResource BAccentSoft}" Margin="6,0,0,0">
                <TextBlock Text="Выбор АМСУР" FontSize="10" Foreground="{StaticResource BAccent}"/>
              </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource THint}" FontSize="11" Margin="0,4,0,0"
                       Text="Рекомендуется: баланс пожеланий. Строгие правила одни для всех." TextWrapping="Wrap"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetStudent" GroupName="Preset" Style="{StaticResource RadioCard}"
                     Margin="3,0,3,0" Checked="OnPresetChanged">
          <StackPanel>
            <TextBlock Text="Удобно ученикам" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource THint}" FontSize="11" Margin="0,4,0,0"
                       Text="Пожелания в пользу учеников. Строгие правила не меняются." TextWrapping="Wrap"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetTeacher" GroupName="Preset" Style="{StaticResource RadioCard}"
                     Margin="3,0,3,0" Checked="OnPresetChanged">
          <StackPanel>
            <TextBlock Text="Удобно учителям" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource THint}" FontSize="11" Margin="0,4,0,0"
                       Text="Пожелания в пользу учителей. Строгие правила не меняются." TextWrapping="Wrap"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetCustom" GroupName="Preset" Style="{StaticResource RadioCard}"
                     Margin="6,0,0,0" Checked="OnPresetChanged">
          <StackPanel>
            <TextBlock Text="Наш профиль" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource THint}" FontSize="11" Margin="0,4,0,0"
                       Text="Ваши сохранённые настройки из базы." TextWrapping="Wrap"/>
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Имя профиля:" VerticalAlignment="Center"/>
        <TextBox x:Name="CustomNameBox" Text="Моя школа" Width="200" Margin="6,0,8,0"/>
        <Button Content="Сохранить «Моя школа»" Style="{StaticResource BtnSecondary}" Click="OnSaveCustomClick"/>
        <TextBlock x:Name="DirtyText" FontSize="12" Foreground="{StaticResource BWarn}"
                   VerticalAlignment="Center" Margin="12,0,0,0" Text=""/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Сбросить к Стандарту" Style="{StaticResource BtnSecondary}" Click="OnResetClick"/>
        <Button Content="Отмена" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="OnCancelClick"/>
        <Button Content="Применить" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnApplyClick"/>
      </StackPanel>
      <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Навигация слева со счётчиками (честные: из Session.Data, иначе 0) -->
      <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="КАТЕГОРИИ" Style="{StaticResource THCaption}" Margin="8,4,8,6"/>
          <ListBox x:Name="SectionList" SelectionChanged="OnSectionChanged" BorderThickness="0" Background="Transparent">
            <ListBoxItem Content="Качество" IsSelected="True"/>
            <ListBoxItem Content="Предметы"/>
            <ListBoxItem Content="Классы"/>
            <ListBoxItem Content="Учителя"/>
            <ListBoxItem Content="Экспертный режим"/>
            <ListBoxItem Content="Предупреждения"/>
          </ListBox>
          <Border Style="{StaticResource Badge}" Background="{StaticResource BGoodBg}" Margin="8,12,8,4">
            <TextBlock Style="{StaticResource THCaption}" TextWrapping="Wrap" Foreground="{StaticResource BGood}"
                       Text="Готово к пуску: строгие правила проверяются автоматически."/>
          </Border>
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1" Margin="0,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel x:Name="QualityPanel"/>
          <StackPanel x:Name="SubjectsPanel" Visibility="Collapsed"/>
          <StackPanel x:Name="ClassesPanel" Visibility="Collapsed"/>
          <StackPanel x:Name="TeachersPanel" Visibility="Collapsed"/>
          <StackPanel x:Name="ExpertPanel" Visibility="Collapsed"/>
          <StackPanel x:Name="WarningsPanel" Visibility="Collapsed"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
