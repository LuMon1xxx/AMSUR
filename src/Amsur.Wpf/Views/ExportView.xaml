<UserControl x:Class="Amsur.Wpf.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24" MaxWidth="1120" TextElement.Foreground="{DynamicResource BText}">
    <TextBlock Style="{StaticResource TH1}" Text="Экспорт и печать"/>
    <TextBlock Style="{StaticResource THint}" Margin="0,4,0,0"
               Text="Три вида: классы, учителя, кабинеты. Выгрузка блокируется, если есть жёсткие нарушения."/>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Параметры выгрузки" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource THCaption}" Margin="0,2,0,0" Text="что войдёт в документ"/>
          <Border Background="{DynamicResource BSubtle}" BorderBrush="{DynamicResource BBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Расписание по классам (основной свод)" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ScopeText" Style="{StaticResource THint}" FontSize="12" Text="—"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <CheckBox x:Name="TeacherSheetBox" Content="Лист «Учителя» (кому когда какой класс)" FontSize="13"
                    Margin="0,10,0,0" IsChecked="True" VerticalAlignment="Center"/>
          <CheckBox x:Name="RoomSheetBox" Content="Лист «Кабинеты» (какой класс каким уроком занят)" FontSize="13"
                    Margin="0,6,0,0" IsChecked="True" VerticalAlignment="Center"/>

          <TextBlock Text="Формат выгрузки:" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8"/>
          <RadioButton x:Name="FormatExcelRadio" GroupName="ExportFormat" Style="{StaticResource RadioCard}"
                       IsChecked="True" Checked="OnFormatChanged">
            <StackPanel Orientation="Horizontal">
              <Border Background="#107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="XLS" FontSize="11" FontWeight="Bold" Foreground="White"/>
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Microsoft Excel (.xlsx)" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource THint}" FontSize="11" Text="Листы «Классы», «Учителя», «Кабинеты» — удобно править и печатать."/>
              </StackPanel>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="FormatHtmlRadio" GroupName="ExportFormat" Style="{StaticResource RadioCard}"
                       Margin="0,8,0,0" Checked="OnFormatChanged">
            <StackPanel Orientation="Horizontal">
              <Border Background="{DynamicResource BAccent}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="HTML" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BAccentForeground}"/>
              </Border>
              <StackPanel Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="HTML для печати / PDF (.html)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource Badge}" Background="{DynamicResource BSubtle}" Margin="6,0,0,0">
                    <TextBlock Text="Ctrl+P → PDF" FontSize="10" Foreground="{DynamicResource BTextSoft}"/>
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource THint}" FontSize="11" Text="Откройте в браузере и сохраните в PDF через печать."/>
              </StackPanel>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="FormatCsvRadio" GroupName="ExportFormat" Style="{StaticResource RadioCard}"
                       Margin="0,8,0,0" Checked="OnFormatChanged">
            <StackPanel Orientation="Horizontal">
              <Border Background="{DynamicResource BSubtle}" BorderBrush="{DynamicResource BBorderStrong}" BorderThickness="1"
                      CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="CSV" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BText}"/>
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Таблица CSV (.csv)" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource THint}" FontSize="11" Text="UTF-8 с «;» для импорта во внешние школьные системы."/>
              </StackPanel>
            </StackPanel>
          </RadioButton>

          <TextBlock Text="Куда сохранить:" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
          <DockPanel>
            <Button Content="Обзор…" Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right"
                    Margin="8,0,0,0" Click="OnBrowseClick"/>
            <TextBox x:Name="PathBox" VerticalAlignment="Center"/>
          </DockPanel>
          <Button x:Name="ExportBtn" x:FieldModifier="public" Style="{StaticResource BtnPrimary}"
                  Margin="0,12,0,0" Padding="16,10" Click="OnExportClick">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="ExportBtnLabel" Text="Выгрузить в Excel (.xlsx)" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="DraftBtn" x:FieldModifier="public" Style="{StaticResource BtnSecondary}"
                  Margin="0,8,0,0" Padding="14,8" Click="OnDraftClick"
                  ToolTip="Жадный старт за секунды: размещённое — в сетку, неназначенное — листом «Неназначенные». Для прикидки, не для печати.">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Собрать черновик (быстро, без генерации)" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Персональное расписание учителя:" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
          <DockPanel>
            <Button Content="Выгрузить" Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right"
                    Margin="8,0,0,0" Click="OnTeacherClick"/>
            <ComboBox x:Name="TeacherBox" x:FieldModifier="public" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <StackPanel x:Name="RevealPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
              <Button x:Name="OpenFileBtn" Content="Открыть файл" Style="{StaticResource BtnSecondary}"
                      Padding="10,4" Click="OnOpenFileClick"
                      ToolTip="Открыть выгруженный файл в программе по умолчанию"/>
              <Button x:Name="ShowInFolderBtn" Content="Показать в папке" Style="{StaticResource BtnSecondary}"
                      Padding="10,4" Margin="8,0,0,0" Click="OnShowInFolderClick"
                      ToolTip="Открыть папку и выделить файл"/>
            </StackPanel>
            <TextBlock x:Name="ResultText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border x:Name="GateBadge" Style="{StaticResource Badge}" Background="{DynamicResource BGoodBg}"
                    DockPanel.Dock="Right" VerticalAlignment="Center">
              <TextBlock x:Name="GateText" x:FieldModifier="public" Text="проверка…" FontSize="11" Foreground="{DynamicResource BGood}"/>
            </Border>
            <TextBlock Text="Предпросмотр" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Style="{StaticResource THint}" FontSize="12" Margin="0,4,0,0"
                     Text="Первые 12 строк активного расписания. Полный файл — все уроки."/>
          <ItemsControl x:Name="PreviewList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource BSubtle}" BorderBrush="{DynamicResource BBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                  <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
  </ScrollViewer>
</UserControl>
