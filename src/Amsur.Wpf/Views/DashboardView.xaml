<UserControl x:Class="Amsur.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid TextElement.Foreground="{DynamicResource BText}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="0"/>
      <ColumnDefinition Width="344"/>
    </Grid.ColumnDefinitions>

    <!-- Центр -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24" MaxWidth="1100">
        <TextBlock x:Name="GreetText" Style="{StaticResource TH1}" Text="Добро пожаловать!"/>
        <TextBlock x:Name="SubText" Style="{StaticResource THint}" Margin="0,4,0,0"
                   Text="Загрузите данные школы, чтобы начать."/>

        <!-- Умный следующий шаг (виден, пока нет данных) -->
        <Border x:Name="NextStepCard" Style="{StaticResource Card}" Margin="0,14,0,0"
                Background="{DynamicResource BWarm}" BorderBrush="{DynamicResource BWarmBorder}"
                Effect="{StaticResource BannerShadow}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="NextStepTitle" FontSize="14" FontWeight="SemiBold" Text="Загрузите данные школы"/>
                <TextBlock x:Name="NextStepText" Style="{StaticResource THint}" FontSize="12" Margin="0,2,0,0"
                           Text="Шаблон Excel → заполнить → загрузить. Это займёт несколько минут."/>
              </StackPanel>
              <Button x:Name="NextStepBtn" x:FieldModifier="public" Grid.Column="1" Content="Загрузить Excel" Style="{StaticResource BtnPrimary}"
                      Padding="16,8" VerticalAlignment="Center" Click="OnNextStepClick"/>
            </Grid>
            <Button x:Name="DemoBtn" x:FieldModifier="public" Content="Нет файла под рукой? Попробовать на демо-данных →"
                    Style="{StaticResource BtnSecondary}" Margin="0,10,0,0" HorizontalAlignment="Left"
                    ToolTip="Загрузит маленькую демо-школу (6 классов) — можно сразу нажимать «Сгенерировать»."
                    Click="OnDemoClick"/>
            <StackPanel x:Name="NextStepInputs" Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Дней:" VerticalAlignment="Center"/>
              <TextBox x:Name="DaysBox" Text="5" Width="48" Padding="4,2" VerticalContentAlignment="Center" Margin="6,0,16,0"/>
              <TextBlock Text="Уроков в день:" VerticalAlignment="Center"/>
              <TextBox x:Name="SlotsBox" Text="7" Width="48" Padding="4,2" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Hero-баннер (спокойный сланцево-бирюзовый без неона) -->
        <Border Margin="0,14,0,0" CornerRadius="10" Background="{DynamicResource HeroBrush}"
                BorderBrush="{DynamicResource BAccentBorder}" BorderThickness="1"
                Padding="22,18" Effect="{StaticResource BannerShadow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Готовы создать расписание?" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="White" Opacity="0.88" TextWrapping="Wrap"
                         Text="Убедитесь, что исходные данные проверены. Выберите режим справа и нажмите запуск."/>
            </StackPanel>
            <Button x:Name="HeroGenerateBtn" Grid.Column="1" VerticalAlignment="Center"
                    Style="{DynamicResource HeroBtn}" Click="OnGenerateClick">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BHeroBtnFg}" VerticalAlignment="Center"/>
                <TextBlock Text="Сгенерировать расписание" Foreground="{DynamicResource BHeroBtnFg}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BHeroBtnBadge}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="F5" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BHeroBtnFg}"/>
                </Border>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource BHeroBtnFg}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Сводка: 3 карточки -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- 1. Данные школы + шаблон Excel -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{DynamicResource BGoodBg}" VerticalAlignment="Center">
                  <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Foreground="{DynamicResource BGood}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="ДАННЫЕ ШКОЛЫ" Style="{StaticResource THCaption}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse x:Name="MiniDataDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource BTextMuted}"/>
                    <TextBlock x:Name="MiniDataStatus" x:FieldModifier="public" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" Text="Не загружены"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="Просмотреть" Style="{StaticResource BtnSecondary}" Padding="10,4" MinWidth="0"
                        VerticalAlignment="Center" Click="OnDataInfoClick"/>
              </Grid>
              <TextBlock x:Name="SchoolCardText" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                         Text="Данные не загружены" TextWrapping="Wrap"/>
              <TextBlock x:Name="SchoolCardDetail" Style="{StaticResource THint}" FontSize="12" Margin="0,2,0,0"
                         Text="Шаблон Excel → заполнить → загрузить."/>
              <TextBlock x:Name="DataDetailText" Style="{StaticResource THint}" FontSize="12" Margin="0,2,0,0" Text=""/>
              <Border BorderBrush="{DynamicResource BBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                            Background="{DynamicResource BGoodBg}" VerticalAlignment="Center">
                      <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                 Foreground="{DynamicResource BGood}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="ШАБЛОН EXCEL" Style="{DynamicResource THCaption}"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Скачать шаблон" Style="{DynamicResource BtnSecondary}" Padding="10,4"
                            MinWidth="0" VerticalAlignment="Center" Click="OnTemplateClick"/>
                  </Grid>
                  <TextBlock x:Name="MiniDataText" Style="{DynamicResource THint}" FontSize="12" TextWrapping="Wrap"
                             Margin="0,6,0,0" Text="Классы, предметы, нагрузка, учителя"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- 2. Профиль качества -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,3,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{DynamicResource BAccentSoft}" VerticalAlignment="Center">
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Foreground="{DynamicResource BAccentText}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="ПРОФИЛЬ КАЧЕСТВА" Style="{StaticResource THCaption}"
                           Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="Изменить" Style="{StaticResource BtnSecondary}" Padding="10,4" MinWidth="0"
                        VerticalAlignment="Center" Click="OnSettingsClick"/>
              </Grid>
              <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="ProfileNameText" FontSize="15" FontWeight="SemiBold" Text="Стандарт" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource BAccentSoft}" Margin="8,2,0,2" VerticalAlignment="Center">
                  <TextBlock x:Name="ProfileVersionText" Text="Рекомендуемый" FontSize="11" Foreground="{DynamicResource BAccentText}"/>
                </Border>
              </WrapPanel>
              <TextBlock Style="{StaticResource THint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="Строгие правила одни для всех профилей: ноль окон у учеников, старт не позже 2-го урока."/>
            </StackPanel>
          </Border>

          <!-- 3. Активное расписание -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{DynamicResource BAccentSoft}" VerticalAlignment="Center">
                  <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Foreground="{DynamicResource BAccentText}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="АКТИВНОЕ РАСПИСАНИЕ" Style="{StaticResource THCaption}"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse x:Name="MiniLastDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource BTextMuted}"/>
                <TextBlock x:Name="MiniLastStatus" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" Text="Не создано"/>
              </StackPanel>
              <TextBlock x:Name="MiniLastText" Style="{StaticResource THint}" FontSize="12" Margin="0,2,0,0"
                         Text="Пока нет" TextWrapping="Wrap"/>
              <Button Content="Перейти к сетке" Style="{StaticResource BtnSecondary}" Margin="0,10,0,0"
                      HorizontalAlignment="Left" Click="OnScheduleClick"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Ошибка импорта -->
        <Border x:Name="ErrorCard" Style="{StaticResource Card}" Margin="0,14,0,0"
                Background="{DynamicResource BBadBg}" BorderBrush="{DynamicResource BBad}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Данные не приняты — что исправить:" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource BBad}"/>
            <ItemsControl x:Name="ErrorList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Выбрать другой файл" Style="{StaticResource BtnSecondary}"
                    Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnImportClick"/>
          </StackPanel>
        </Border>

        <!-- Быстрый старт: 5 шагов -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource BAccentText}" VerticalAlignment="Center"/>
                <TextBlock Text="Быстрый старт" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="— пошаговый порядок составления" Style="{StaticResource THint}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Подробнее о работе" Style="{StaticResource BtnSecondary}" Padding="10,4" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnHelpClick"/>
            </Grid>
            <UniformGrid Columns="5" Rows="1" Margin="0,12,0,0">
              <StackPanel Margin="0,0,6,0">
                <Border x:Name="Step1Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BAccent}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Step1Num" Tag="1" Text="1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Загрузите данные" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Классы и нагрузка" Style="{StaticResource THint}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="3,0,3,0">
                <Border x:Name="Step2Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BAccent}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Step2Num" Tag="2" Text="2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Выберите профиль" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="MiniProfileText" Style="{StaticResource THint}" FontSize="12" Text="Стандарт" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="3,0,3,0">
                <Border x:Name="Step3Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BAccent}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Step3Num" Tag="3" Text="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Запустите расчёт" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Оптимизатор CP-SAT" Style="{StaticResource THint}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="3,0,3,0">
                <Border x:Name="Step4Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BSubtle}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Step4Num" Tag="4" Text="4" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BTextSoft}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Проверьте результат" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Окна и накладки" Style="{StaticResource THint}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <Border x:Name="Step5Circle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BSubtle}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Step5Num" Tag="5" Text="5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BTextSoft}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Экспортируйте" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="В Excel" Style="{StaticResource THint}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Правая колонка 344px -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,16,18,16">
        <TextBlock Text="ВЫБОР РЕЖИМА ГЕНЕРАЦИИ" Style="{DynamicResource THCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel x:Name="ModeCards"/>
        <TextBlock Text="КАЧЕСТВО РАСПИСАНИЯ" Style="{DynamicResource THCaption}" FontWeight="SemiBold" Margin="0,10,0,6"/>
        <Border Style="{DynamicResource Card}" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="QualityLabelText" FontSize="15" FontWeight="SemiBold" Text="—"/>
            <ProgressBar x:Name="QualityBar" Height="7" Minimum="0" Maximum="1" Value="0"
                         Margin="0,6,0,0" Foreground="{DynamicResource BGood}"
                         Background="{DynamicResource BSubtle}" BorderThickness="0"/>
            <TextBlock Text="ЧТО МОЖНО УЛУЧШИТЬ:" Style="{DynamicResource THCaption}" Margin="0,8,0,2"/>
            <ItemsControl x:Name="QualityList" Margin="0,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Dot}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="QualityDetailsBtn" Content="Показать подробный анализ" Style="{DynamicResource BtnSecondary}"
                    Margin="0,8,0,0" Padding="10,5" Click="OnQualityDetailsClick"/>
          </StackPanel>
        </Border>
        <Border x:Name="AdviceCard" Style="{DynamicResource Card}" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource BAccentSoft}" BorderBrush="{DynamicResource BAccentBorder}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource BAccentText}" VerticalAlignment="Center"/>
                <TextBlock Text="Советы" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                      Style="{StaticResource BtnSecondary}" Padding="6,2" MinWidth="0" VerticalAlignment="Center"
                      ToolTip="Закрыть" Click="OnAdviceClose"/>
            </Grid>
            <TextBlock Style="{StaticResource THint}" FontSize="12" Margin="0,6,0,0"
                       Text="Если у вас нестандартные требования к расписанию, вы можете настроить все параметры в разделе «Настройки и профили»."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
