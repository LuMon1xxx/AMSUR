<UserControl x:Class="Amsur.Wpf.Views.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Amsur.Wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24" MaxWidth="1200" TextElement.Foreground="{DynamicResource BText}">
    <!-- Верх: заголовок + статус + режимы -->
    <Border Style="{DynamicResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" Style="{DynamicResource TH1}" VerticalAlignment="Center"/>
          <Border Style="{DynamicResource Badge}" Background="{DynamicResource BAccentSoft}"
                  Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="11" Foreground="{DynamicResource BAccentText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="поиск завершён"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanStop}" Value="True">
                      <Setter Property="Text" Value="идёт поиск"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding QualityProfileText}" FontSize="13" Foreground="{DynamicResource BTextSoft}" Margin="0,4,0,0"/>
        <TextBlock Text="Режимы (клик по карточке — выбрать):" Style="{DynamicResource THCaption}" Margin="0,12,0,6"/>
        <UniformGrid x:Name="ModeStrip" Columns="5" Rows="1"/>
      </StackPanel>
    </Border>

    <!-- Стадии VM: 4 шага -->
    <ItemsControl ItemsSource="{Binding Stages}" Margin="-4,12,-4,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="StageFrame" CornerRadius="8" Padding="12,8" Margin="4,0,4,0"
                  Background="{DynamicResource BCard}" BorderBrush="{DynamicResource BBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="StageDot" CornerRadius="10" Width="20" Height="20"
                      Background="{DynamicResource BSubtle}" VerticalAlignment="Center">
                <TextBlock x:Name="StageMark" Text="·" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource BTextMuted}"/>
              </Border>
              <TextBlock x:Name="StageText" Text="{Binding Name}" FontSize="13" Margin="8,0,0,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource BTextSoft}"/>
            </StackPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="StageFrame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              <Setter TargetName="StageFrame" Property="BorderThickness" Value="1.5"/>
              <Setter TargetName="StageFrame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              <Setter TargetName="StageText" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="StageText" Property="Foreground" Value="{DynamicResource BAccentText}"/>
              <Setter TargetName="StageDot" Property="Background" Value="{DynamicResource BAccent}"/>
              <Setter TargetName="StageMark" Property="Text" Value="→"/>
              <Setter TargetName="StageMark" Property="Foreground" Value="{DynamicResource BAccentForeground}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
              <Setter TargetName="StageDot" Property="Background" Value="{DynamicResource BGood}"/>
              <Setter TargetName="StageMark" Property="Text" Value="✓"/>
              <Setter TargetName="StageMark" Property="Foreground" Value="{DynamicResource BAccentForeground}"/>
              <Setter TargetName="StageText" Property="Foreground" Value="{DynamicResource BText}"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" Rows="1"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- Метрики -->
    <UniformGrid Columns="4" Rows="1" Margin="0,12,0,0">
      <Border Style="{DynamicResource Card}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="ПЕРВОЕ РЕШЕНИЕ" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding FirstFeasibleText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="3,0,3,0">
        <StackPanel>
          <TextBlock Text="ЛУЧШЕЕ СЕЙЧАС" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding BestText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                     Foreground="{DynamicResource BAccentText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="3,0,3,0">
        <StackPanel>
          <TextBlock Text="ВАРИАНТОВ В ПУЛЕ" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding CandidatesText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card}" Margin="6,0,0,0">
        <StackPanel>
          <TextBlock Text="ВРЕМЯ РАСЧЁТА" Style="{DynamicResource THCaption}"/>
          <TextBlock Text="{Binding ElapsedText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Прогресс + Стоп/Перезапуск -->
    <Border Style="{DynamicResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="1"
                     IsIndeterminate="{Binding CanStop}" Foreground="{DynamicResource BAccent}"
                     Background="{DynamicResource BSubtle}" BorderThickness="0"/>
        <DockPanel Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button x:Name="StopButton" Style="{DynamicResource BtnSecondary}"
                    Padding="14,7" IsEnabled="{Binding CanStop}" Click="OnStopClick">
              <TextBlock Text="⦸  Остановить расчёт">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource BTextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CanStop}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource BBad}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>
            <Button x:Name="RestartButton" Content="↻  Перезапустить расчёт" Style="{DynamicResource BtnSecondary}"
                    Padding="14,7" Margin="8,0,0,0" IsEnabled="False" Click="OnRestartClick"/>
          </StackPanel>
          <TextBlock Text="{Binding RunStateText}" Style="{DynamicResource THint}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- График -->
    <TextBlock Text="Ход улучшения" Style="{DynamicResource TH2}" Margin="0,18,0,8"/>
    <Border Style="{DynamicResource Card}">
      <local:TrajectoryChart x:Name="Chart"/>
    </Border>

    <!-- Top-5 вариантов: любой можно принять или открыть в редакторе -->
    <DockPanel Margin="0,18,0,8">
      <TextBlock Text="{Binding Top5.HeaderText}" Style="{DynamicResource TH2}" VerticalAlignment="Center"/>
      <TextBlock Style="{DynamicResource THCaption}" DockPanel.Dock="Right" VerticalAlignment="Center"
                 Margin="16,0,0,0" Text="сортировка — по минимуму окон и качеству (Soft)"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding Top5.Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{DynamicResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Style="{DynamicResource Badge}" Background="{DynamicResource BAccentSoft}"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BAccentText}"/>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SoftText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Style="{DynamicResource Badge}" Background="{DynamicResource BGoodBg}"
                          Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HardText}" FontSize="11" Foreground="{DynamicResource BGood}"/>
                  </Border>
                </StackPanel>
              </DockPanel>

              <TextBlock Text="{Binding QualitySummary}" FontSize="13" FontWeight="Medium"
                         Foreground="{DynamicResource BText}" Margin="0,8,0,0" TextWrapping="Wrap"/>

              <Border Background="{DynamicResource BSubtle}" BorderBrush="{DynamicResource BBorder}"
                      BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="Почему такая оценка:" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource BTextSoft}" Margin="0,0,0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding QualityLines.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                    <ItemsControl ItemsSource="{Binding QualityLines}" Padding="0,0,0,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource BTextSoft}"
                                     Margin="0,1,0,1" TextWrapping="Wrap"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Border Height="1" Background="{DynamicResource BBorder}" Margin="0,4,0,6">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding QualityLines.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DifferenceLines.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <ItemsControl ItemsSource="{Binding DifferenceLines}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource BText}"
                                   Margin="0,1,0,1" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="✓  Принять этот вариант" FontSize="13"
                        Margin="0,0,8,0" Tag="{Binding}" Click="OnAcceptClick">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CanAccept}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="Открыть в редакторе" Style="{DynamicResource BtnSecondary}" Tag="{Binding}"
                        Click="OnOpenClick"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Черновик-фолбэк -->
    <StackPanel x:Name="DraftPanel" Margin="0,12,0,0"/>

    <!-- Итог приёмки + активная версия -->
    <TextBlock Text="{Binding AcceptResultText}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding ActiveVersionText}" FontSize="13" Foreground="{DynamicResource BTextSoft}"/>

    <!-- Diagnostics -->
    <Border Style="{DynamicResource Card}" Margin="0,12,0,0">
      <Expander Header="Подробности генерации" IsExpanded="{Binding DiagnosticsExpanded}" FontSize="13">
        <StackPanel Margin="8,8,0,0">
          <TextBlock x:Name="DiagSeed" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagWorkers" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagPhase" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagSolver" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagElapsed" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagObjective" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagValidation" FontSize="12" Style="{DynamicResource THCaption}"/>
          <TextBlock x:Name="DiagCounts" FontSize="12" Style="{DynamicResource THCaption}"/>
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
