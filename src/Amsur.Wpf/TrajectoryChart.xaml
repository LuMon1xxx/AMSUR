<UserControl x:Class="Amsur.Wpf.TrajectoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="190">
  <Border BorderThickness="1" BorderBrush="{DynamicResource BBorder}" Background="{DynamicResource BSubtle}" CornerRadius="6" Padding="8">
    <Grid>
      <TextBlock x:Name="EmptyText" Text="Пока нет данных — идёт сбор событий…"
                 FontSize="12" Foreground="{DynamicResource BTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"/>
      <Canvas x:Name="Plot" Visibility="Collapsed" ClipToBounds="True"/>
    </Grid>
  </Border>
</UserControl>
