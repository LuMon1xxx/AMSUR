<Window x:Class="Amsur.Wpf.DangerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Осторожно" Height="260" Width="480"
        MinWidth="420" MinHeight="240" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{DynamicResource ChromeWindow}"
        Background="{StaticResource BBg}">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource BWarnBg}" VerticalAlignment="Center">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                   Foreground="{StaticResource BWarn}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock x:Name="BodyText" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
    <TextBlock FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Шаблонная школа так не делает. Продолжить?"/>
    <CheckBox x:Name="DontAskBox" Content="Больше не спрашивать об опасных изменениях"
              FontSize="12" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelBtn" Content="Отмена" Style="{StaticResource BtnSecondary}"
              Padding="16,7" IsCancel="True" Click="OnCancelClick"/>
      <Button x:Name="ContinueBtn" Content="Продолжить" Style="{StaticResource BtnPrimary}"
              Padding="16,7" Margin="8,0,0,0" Click="OnContinueClick"/>
    </StackPanel>
  </StackPanel>
</Window>
