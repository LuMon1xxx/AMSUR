<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- P-D5: тёмная тема. ТОЛЬКО цвета/кисти/hero — те же x:Key, что светлая.
       Стили/радиусы/отступы живут в App.xaml и не дублируются.
       Применение: App.ApplyDarkTheme() копирует записи поверх Resources
       ДО загрузки окон (StaticResource резолвится при загрузке). -->

  <Color x:Key="CAccent">#7DD3FC</Color>
  <Color x:Key="CAccentDark">#38BDF8</Color>
  <Color x:Key="CAccentPressed">#0EA5E9</Color>
  <Color x:Key="CAccentSoft">#0C2437</Color>
  <Color x:Key="CAccentBorder">#155E75</Color>
  <Color x:Key="CBg">#0B1220</Color>
  <Color x:Key="CCard">#111C30</Color>
  <Color x:Key="CSubtle">#1A2740</Color>
  <Color x:Key="CBorder">#26334D</Color>
  <Color x:Key="CBorderStrong">#33415C</Color>
  <Color x:Key="CText">#E8EEF7</Color>
  <Color x:Key="CTextSoft">#A9B6CB</Color>
  <Color x:Key="CTextSecondary">#A9B6CB</Color>
  <Color x:Key="CTextMuted">#64748B</Color>
  <Color x:Key="CGood">#34D399</Color>
  <Color x:Key="CWarn">#FBBF24</Color>
  <Color x:Key="CBad">#F87171</Color>
  <Color x:Key="CGoodBg">#052E22</Color>
  <Color x:Key="CWarnBg">#451A03</Color>
  <Color x:Key="CBadBg">#450A0A</Color>
  <!-- Тёплый акцент Гуфо в тёмной теме: глубокий янтарь -->
  <Color x:Key="CWarm">#451A03</Color>
  <Color x:Key="CWarmBorder">#92400E</Color>

  <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}"/>
  <SolidColorBrush x:Key="BAccentDark" Color="{StaticResource CAccentDark}"/>
  <SolidColorBrush x:Key="BAccentPressed" Color="{StaticResource CAccentPressed}"/>
  <SolidColorBrush x:Key="BAccentSoft" Color="{StaticResource CAccentSoft}"/>
  <SolidColorBrush x:Key="BAccentBorder" Color="{StaticResource CAccentBorder}"/>
  <SolidColorBrush x:Key="BBg" Color="{StaticResource CBg}"/>
  <SolidColorBrush x:Key="BCard" Color="{StaticResource CCard}"/>
  <SolidColorBrush x:Key="BSubtle" Color="{StaticResource CSubtle}"/>
  <SolidColorBrush x:Key="BBorder" Color="{StaticResource CBorder}"/>
  <SolidColorBrush x:Key="BBorderStrong" Color="{StaticResource CBorderStrong}"/>
  <SolidColorBrush x:Key="BText" Color="{StaticResource CText}"/>
  <SolidColorBrush x:Key="BTextSoft" Color="{StaticResource CTextSoft}"/>
  <SolidColorBrush x:Key="BTextSecondary" Color="{StaticResource CTextSecondary}"/>
  <SolidColorBrush x:Key="BTextMuted" Color="{StaticResource CTextMuted}"/>
  <SolidColorBrush x:Key="BGood" Color="{StaticResource CGood}"/>
  <SolidColorBrush x:Key="BWarn" Color="{StaticResource CWarn}"/>
  <SolidColorBrush x:Key="BBad" Color="{StaticResource CBad}"/>
  <SolidColorBrush x:Key="BGoodBg" Color="{StaticResource CGoodBg}"/>
  <SolidColorBrush x:Key="BWarnBg" Color="{StaticResource CWarnBg}"/>
  <SolidColorBrush x:Key="BBadBg" Color="{StaticResource CBadBg}"/>
  <SolidColorBrush x:Key="BWarm" Color="{StaticResource CWarm}"/>
  <SolidColorBrush x:Key="BWarmBorder" Color="{StaticResource CWarmBorder}"/>

  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0EA5E9" Offset="0"/>
    <GradientStop Color="#4F46E5" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
