<Window x:Class="Amsur.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АМСУР — школьное расписание" Height="860" Width="1280"
        MinWidth="1024" MinHeight="680" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Style="{DynamicResource ChromeWindow}"
        Background="{DynamicResource BBg}">
  <DockPanel TextElement.Foreground="{DynamicResource BText}">
    <!-- Нижний статус-бар -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BSidebar}"
            BorderBrush="{DynamicResource BBorder}" BorderThickness="0,1,0,0" Padding="18,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterLeftText" Grid.Column="0" FontSize="11"
                   Foreground="{DynamicResource BTextSoft}" VerticalAlignment="Center"
                   Text="Движок: CP-SAT + локальный поиск · СанПиН: требует сверки с НПА №206/№35"/>
        <TextBlock x:Name="FooterRightText" x:FieldModifier="public" Grid.Column="1" FontSize="11"
                   Foreground="{DynamicResource BTextSoft}" VerticalAlignment="Center" Text="Нет данных"/>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="244"/>
        <ColumnDefinition Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <!-- Левая навигация 244px: чистая структура без тяжёлых баннеров -->
      <Border Grid.Column="0" Background="{DynamicResource BSidebar}"
              BorderBrush="{DynamicResource BBorder}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,10,12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ШАГИ" Style="{StaticResource THCaption}" FontWeight="SemiBold" Margin="12,2,0,8"/>
            <Button x:Name="NavHome" Content="Главная" Tag="&#xE80F;" Style="{StaticResource NavBtnActive}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Grid Margin="0,0,0,2">
              <Button x:Name="NavData" Content="1. Школа и нагрузка" Tag="&#xE779;" Style="{StaticResource NavBtn}" Click="OnNavClick"/>
              <Border x:Name="SchoolNavBadgeFrame" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      IsHitTestVisible="False" Background="{DynamicResource BSubtle}"
                      BorderBrush="{DynamicResource BBorder}" BorderThickness="1"
                      CornerRadius="4" Padding="6,1" Visibility="Collapsed">
                <TextBlock x:Name="SchoolNavBadge" FontSize="10" Foreground="{DynamicResource BTextSoft}" Text=""/>
              </Border>
            </Grid>
            <Button x:Name="NavGenerate" Content="2. Создание расписания" Tag="&#xE768;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavSchedule" Content="3. Расписание и правка" Tag="&#xE787;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavExport" Content="4. Выгрузка и печать" Tag="&#xE749;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{DynamicResource BBorder}" Margin="6,4,6,8"/>
            <Button x:Name="NavSettings" Content="Настройки и профили" Tag="&#xE713;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <!-- Дубль пути в настройки скрыт; поле оставлено для совместимости с тестами -->
            <Button x:Name="NavProfiles" Content="Профили" Tag="&#xE735;" Style="{StaticResource NavBtn}"
                    Visibility="Collapsed" Margin="0,0,0,2" Click="OnNavClick"/>
            <Grid Margin="0,0,0,2">
              <Button x:Name="NavHelp" Content="Справка" Tag="&#xE897;" Style="{StaticResource NavBtn}" Click="OnNavClick"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      IsHitTestVisible="False" Background="{DynamicResource BSubtle}"
                      BorderBrush="{DynamicResource BBorder}" BorderThickness="1"
                      CornerRadius="4" Padding="6,1">
                <TextBlock Text="F1" FontSize="10" Foreground="{DynamicResource BTextSoft}"/>
              </Border>
            </Grid>
            <Border Height="1" Background="{DynamicResource BBorder}" Margin="6,8,6,6"/>
            <CheckBox x:Name="ThemeBox" Content="Тёмная тема" Style="{StaticResource ToggleSwitch}"
                      ToolTip="Переключает светлую и тёмную тему мгновенно."
                      Checked="OnThemeChanged" Unchecked="OnThemeChanged"/>
            <TextBlock Text="Версия 2.0 · .NET 10 WPF" FontSize="11" Foreground="{DynamicResource BTextMuted}"
                       Margin="10,4,10,2"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Хостер разделов -->
      <ContentControl x:Name="ViewHost" x:FieldModifier="public" Grid.Column="1"/>
    </Grid>
  </DockPanel>
</Window>
