<Window x:Class="Amsur.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АМСУР — школьное расписание" Height="900" Width="1600"
        MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Style="{DynamicResource ChromeWindow}"
        Background="{StaticResource BBg}">
  <!-- P-D0: оболочка одного окна. Контент разделов — views в ViewHost,
       навигация — Navigator в code-behind. Дашборд живёт в Views/DashboardView. -->
  <DockPanel TextElement.Foreground="{DynamicResource BText}">
    <!-- Нижний статус-бар -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BCard}"
            BorderBrush="{StaticResource BBorder}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterLeftText" Grid.Column="0" FontSize="11"
                   Foreground="{StaticResource BTextSoft}" VerticalAlignment="Center"
                   Text="Движок: CP-SAT + локальный поиск · СанПиН: требует сверки с НПА №206/№35"/>
        <TextBlock x:Name="FooterRightText" x:FieldModifier="public" Grid.Column="1" FontSize="11"
                   Foreground="{StaticResource BTextSoft}" VerticalAlignment="Center" Text="Нет данных"/>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <!-- Левая навигация 240px -->
      <Border Grid.Column="0" Background="{StaticResource BCard}"
              BorderBrush="{StaticResource BBorder}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="МОДУЛИ" Style="{StaticResource THCaption}" Margin="12,2,0,8"/>
            <Button x:Name="NavHome" Content="Главная" Tag="&#xE80F;" Style="{StaticResource NavBtnActive}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Grid Margin="0,0,0,2">
              <Button x:Name="NavData" Content="Школа и данные" Tag="&#xE779;" Style="{StaticResource NavBtn}" Click="OnNavClick"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      IsHitTestVisible="False" Background="{StaticResource BSubtle}" CornerRadius="4" Padding="6,1">
                <TextBlock x:Name="SchoolNavBadge" FontSize="10" Foreground="{StaticResource BTextSoft}" Text=""/>
              </Border>
            </Grid>
            <Button x:Name="NavSettings" Content="Настройки качества" Tag="&#xE713;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavGenerate" Content="Генерация расписания" Tag="&#xE768;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavSchedule" Content="Расписание" Tag="&#xE787;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavExport" Content="Экспорт и печать" Tag="&#xE749;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavProfiles" Content="Профили" Tag="&#xE735;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
            <Button x:Name="NavHelp" Content="Справка  (F1)" Tag="&#xE897;" Style="{StaticResource NavBtn}" Margin="0,0,0,2" Click="OnNavClick"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8" Background="{StaticResource BAccentSoft}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BAccent}"
                          VerticalAlignment="Center" ToolTip="Гуфо — помощник АМСУР">
                    <TextBlock Text="Г" FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Гуфо на связи" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource THint}" FontSize="12" Margin="0,4,0,8"
                           Text="Быстрый старт и ответы — в справке. F1 открывает справку, F5 запускает генерацию."/>
                <Button Style="{StaticResource BtnSecondary}" Click="OnHelpNav">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Открыть справку" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BSubtle}" BorderBrush="{StaticResource BBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="F1" FontSize="10" Foreground="{StaticResource BTextSoft}"/>
                    </Border>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <TextBlock Text="Версия 2.0 · .NET 10 WPF" FontSize="11" Foreground="{StaticResource BTextSoft}"/>
            <CheckBox x:Name="ThemeBox" Content="Тёмная тема" Margin="0,8,0,0"
                      ToolTip="Переключает светлую/тёмную тему. Применится после перезапуска."
                      Checked="OnThemeChanged" Unchecked="OnThemeChanged"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Хостер разделов -->
      <ContentControl x:Name="ViewHost" x:FieldModifier="public" Grid.Column="1"/>
    </Grid>
  </DockPanel>
</Window>
