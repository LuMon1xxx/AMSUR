<Application x:Class="Amsur.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Этап C: visual system — светлая спокойная тема, сине-фиолетовый акцент -->
    <!-- P0-0: токены выровнены под Stitch-handoff (S5 decision: честные значения, ключи сохранены) -->
    <Color x:Key="CAccent">#4F46E5</Color>
    <Color x:Key="CAccentDark">#4338CA</Color>
    <Color x:Key="CAccentPressed">#3730A3</Color>
    <Color x:Key="CAccentSoft">#EEF2FF</Color>
    <Color x:Key="CAccentBorder">#C7D2FE</Color>
    <Color x:Key="CBg">#F8FAFC</Color>
    <Color x:Key="CCard">#FFFFFF</Color>
    <Color x:Key="CSubtle">#F1F5F9</Color>
    <Color x:Key="CBorder">#E2E8F0</Color>
    <Color x:Key="CBorderStrong">#CBD5E1</Color>
    <Color x:Key="CText">#0F172A</Color>
    <Color x:Key="CTextSoft">#475569</Color>
    <Color x:Key="CTextSecondary">#475569</Color>
    <Color x:Key="CTextMuted">#94A3B8</Color>
    <Color x:Key="CGood">#059669</Color>
    <Color x:Key="CWarn">#D97706</Color>
    <Color x:Key="CBad">#DC2626</Color>
    <Color x:Key="CGoodBg">#ECFDF5</Color>
    <Color x:Key="CWarnBg">#FFFBEB</Color>
    <Color x:Key="CBadBg">#FEF2F2</Color>

    <SolidColorBrush x:Key="BAccent" Color="{DynamicResource CAccent}"/>
    <SolidColorBrush x:Key="BAccentDark" Color="{DynamicResource CAccentDark}"/>
    <SolidColorBrush x:Key="BAccentPressed" Color="{DynamicResource CAccentPressed}"/>
    <SolidColorBrush x:Key="BAccentSoft" Color="{DynamicResource CAccentSoft}"/>
    <SolidColorBrush x:Key="BAccentBorder" Color="{DynamicResource CAccentBorder}"/>
    <SolidColorBrush x:Key="BBg" Color="{DynamicResource CBg}"/>
    <SolidColorBrush x:Key="BCard" Color="{DynamicResource CCard}"/>
    <SolidColorBrush x:Key="BSubtle" Color="{DynamicResource CSubtle}"/>
    <SolidColorBrush x:Key="BBorder" Color="{DynamicResource CBorder}"/>
    <SolidColorBrush x:Key="BBorderStrong" Color="{DynamicResource CBorderStrong}"/>
    <SolidColorBrush x:Key="BText" Color="{DynamicResource CText}"/>
    <SolidColorBrush x:Key="BTextSoft" Color="{DynamicResource CTextSoft}"/>
    <SolidColorBrush x:Key="BTextSecondary" Color="{DynamicResource CTextSecondary}"/>
    <SolidColorBrush x:Key="BTextMuted" Color="{DynamicResource CTextMuted}"/>
    <SolidColorBrush x:Key="BGood" Color="{DynamicResource CGood}"/>
    <SolidColorBrush x:Key="BWarn" Color="{DynamicResource CWarn}"/>
    <SolidColorBrush x:Key="BBad" Color="{DynamicResource CBad}"/>
    <SolidColorBrush x:Key="BGoodBg" Color="{DynamicResource CGoodBg}"/>
    <SolidColorBrush x:Key="BWarnBg" Color="{DynamicResource CWarnBg}"/>
    <SolidColorBrush x:Key="BBadBg" Color="{DynamicResource CBadBg}"/>
    <!-- P-D0: тёплый сабтл для дружелюбных панелей + Гуфо -->
    <SolidColorBrush x:Key="BWarm" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="BWarmBorder" Color="#FED7AA"/>

    <!-- P-D0: базовые анимации (только accelerate-free, без сторонних библиотек).
         PressDown/PressUp: лёгкое сжатие при нажатии (90/120мс).
         Применение: в шаблоне кнопки именованный ScaleTransform x:Name="PressScale"
         (каждый шаблон — свой инстанс, сториборды общие резолвят имя в неймскопе).
         ViewEnter: появление view (fade + подъём 12px, 220мс) — запуск из кода,
         цель сториборда задаёт вызыватель (Storyboard.SetTarget). -->
    <Storyboard x:Key="PressDown">
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleX"
                       To="0.96" Duration="0:0:0.09"/>
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleY"
                       To="0.96" Duration="0:0:0.09"/>
    </Storyboard>
    <Storyboard x:Key="PressUp">
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleX"
                       To="1" Duration="0:0:0.12"/>
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleY"
                       To="1" Duration="0:0:0.12"/>
    </Storyboard>

    <CornerRadius x:Key="RCard">12</CornerRadius>
    <CornerRadius x:Key="RControl">8</CornerRadius>
    <CornerRadius x:Key="RTag">4</CornerRadius>
    <Thickness x:Key="TCardPadding">16</Thickness>

    <!-- P0-0: hero-градиент Stitch (135deg #2563EB → #4F46E5); D4: третий стоп
         для глубины (индиго → фиолет), направление чуть круче -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0.85">
      <GradientStop Color="#2563EB" Offset="0"/>
      <GradientStop Color="#4F46E5" Offset="0.55"/>
      <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- D4: мягкая тень баннеров (hero + следующий шаг). Чёрная с низкой
         непрозрачностью — корректна и в тёмной теме (там почти не видна). -->
    <DropShadowEffect x:Key="BannerShadow" Color="Black" Opacity="0.18"
                      BlurRadius="18" ShadowDepth="5" Direction="270"/>

    <Style x:Key="TH1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
    </Style>
    <Style x:Key="TH2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
    </Style>
    <Style x:Key="THint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- P0-0: дополнительные текстовые стили handoff -->
    <Style x:Key="THBody" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="THCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TBMono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RCard}"/>
      <Setter Property="Padding" Value="{StaticResource TCardPadding}"/>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BAccent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentDark}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentPressed}"/>
              </Trigger>
              <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BCard}"/>
      <Setter Property="Foreground" Value="{DynamicResource BAccent}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentBorder}"/>
              </Trigger>
              <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BAccentSoft}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- Карточка-режим: RadioButton как выбираемая панель -->
    <Style x:Key="RadioCard" TargetType="RadioButton">
      <Setter Property="Background" Value="{DynamicResource BCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P0-9: современные тонкие скроллбары без стрелок (implicit — все ScrollViewer/DataGrid) -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource BBorderStrong}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BTextMuted}"/>
        </Trigger>
        <Trigger Property="IsDragging" Value="True">
          <Setter Property="Background" Value="{DynamicResource BAccent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollBarThumb}" Margin="3,2"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
          <Track.DecreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource ScrollBarThumb}" Margin="2,3"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="MinHeight" Value="12"/>
          <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- P1-shell: современные поля ввода (implicit — все TextBox приложения) -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="IBeam"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BBorderStrong}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource BTextMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P1-shell: современные комбобоксы (implicit — фильтры расписания/данных) -->
    <Style x:Key="ComboBoxToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="0,0,8,0">
              <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource BTextMuted}"
                    StrokeThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource BAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource BCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Frame" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6" SnapsToDevicePixels="True"/>
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <ToggleButton Grid.Column="1" Style="{DynamicResource ComboBoxToggle}" Width="20"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource BCard}" BorderBrush="{DynamicResource BBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="2"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BBorderStrong}"/>
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource BTextMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P-C: современный чекбокс (implicit — тумблер перегрузки и все остальные) -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                      Background="{DynamicResource BCard}" BorderBrush="{DynamicResource BBorderStrong}"
                      BorderThickness="1.5" VerticalAlignment="Center">
                <Path x:Name="Glyph" Data="M 4 8.5 L 7.5 12 L 13 4.5" Stroke="White"
                      StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"
                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P-C: акцентный прогрессбар (implicit — генерация и панель качества) -->
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource BSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource BAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="3" HorizontalAlignment="Left"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P-C: заголовки гридов (implicit — где нет локального стиля) -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BBorder}"/>
    </Style>

    <!-- P1-shell: пункты боковых списков (категории настроек, справочники) -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BSubtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource BAccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource BAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P1-shell: современные слайдеры настроек (трек + круглая ручка) -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Background" Value="{DynamicResource BSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource BAccent}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="{DynamicResource BAccent}" StrokeThickness="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P1-shell: экспандеры со шевроном вместо штатного треугольника -->
    <Style TargetType="Expander">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal">
                      <Path x:Name="Glyph" Data="M 0 0 L 0 8 L 5 4 Z" Fill="{DynamicResource BTextSoft}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                        VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Glyph" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" ContentSource="Content" Margin="18,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P1-shell: ячейки гридов без фокус-рамки -->
    <Style TargetType="DataGridCell">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- P1-shell: кнопки навбар-рейла (иконка MDL2 из Tag + текст) -->
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavFrame" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource BText}"/>
              </Trigger>
              <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard Storyboard="{StaticResource PressDown}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource PressUp}"/>
              </EventTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Background" Value="{DynamicResource BAccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource BAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- P1-shell: кнопки кастомного титулбара (SystemCommands — без кода) -->
    <Style x:Key="TitleBarBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BTextSoft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BSubtle}"/>
          <Setter Property="Foreground" Value="{DynamicResource BText}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- P1-shell: кастомный хром окон (DynamicResource — STA-тесты без ресурсов грузят голое окно) -->
    <!-- x:Shared=False: WindowChrome не freezable — каждому окну свой экземпляр (иначе межпоточный InvalidOperation) -->
    <Style x:Key="ChromeWindow" x:Shared="False" TargetType="Window">
      <Setter Property="WindowStyle" Value="None"/>
      <Setter Property="ResizeMode" Value="CanResize"/>
      <Setter Property="Background" Value="{DynamicResource BBg}"/>
      <Setter Property="WindowChrome.WindowChrome">
        <Setter.Value>
          <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Window">
            <Border x:Name="ChromeFrame" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BBorder}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Height="44" Background="{DynamicResource BCard}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource BAccent}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="4" Height="9" CornerRadius="2" Background="White" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Border Width="4" Height="14" CornerRadius="2" Background="White" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Border Width="4" Height="11" CornerRadius="2" Background="White" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="АМСУР" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Width="1" Background="{DynamicResource BBorder}" Margin="10,8" VerticalAlignment="Stretch"/>
                    <TextBlock Text="{TemplateBinding Title}" FontSize="12" Foreground="{DynamicResource BTextSoft}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarBtn}" Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="Свернуть"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource TitleBarBtn}" Content="&#xE922;" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="Развернуть"/>
                    <Button x:Name="RestoreBtn" Style="{StaticResource TitleBarBtn}" Content="&#xE923;" Command="{x:Static SystemCommands.RestoreWindowCommand}" ToolTip="Восстановить" Visibility="Collapsed"/>
                    <Button Style="{StaticResource TitleBarCloseBtn}" Content="&#xE8BB;" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="Закрыть"/>
                  </StackPanel>
                </Grid>
                <AdornerDecorator>
                  <ContentPresenter/>
                </AdornerDecorator>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="WindowState" Value="Maximized">
                <Setter TargetName="MaxBtn" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RestoreBtn" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ChromeFrame" Property="Padding" Value="8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- P0-9: кнопка без явного Style получает скруглённый BtnSecondary (лечит прямоугольный Hero) -->
    <Style TargetType="Button" BasedOn="{StaticResource BtnSecondary}"/>
  </Application.Resources>
</Application>
